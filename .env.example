# Host — Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development
ENVIRONMENT=Development

# Database
DB_CONNECTION_STRING=

# Redis (redis://, rediss://, or StackExchange form). Use the external/public URL from a laptop.
REDIS_URL=

# Auth & HTTP
JWT_SECRET=
CORS_ORIGINS=
WEB_BASE_URL=
ADMIN_WEB_BASE_URL=

# MSG91 OTP SMS (Enabled comes from appsettings, not here)
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=YAKKU

# Resend
RESEND_API_KEY=

# Firebase (service-account JSON fields; keep FIREBASE_PRIVATE_KEY on one line with \n)
FIREBASE_TYPE=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=

# S3-compatible storage
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Razorpay (Enabled comes from appsettings; use Test Mode keys outside Production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Admin
ADMIN_SECRET_CODE=
