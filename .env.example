# Copy this file to .env and fill in real values.
# Never commit .env.

# Database
DB_CONNECTION_STRING=

# Redis (OTP challenge store)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend
# Sender address lives on the published OTP template, not on this request.
RESEND_API_KEY=
RESEND_OTP_TEMPLATE_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Cloud Messaging (push notifications)
# Values come from the Firebase service-account JSON (one .env key per JSON field).
# For FIREBASE_PRIVATE_KEY, keep it on one line and use \n for newlines.
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# JWT (access tokens). Must be at least 32 characters.
JWT_SECRET=

# CORS Origins. Comma separated list of origins. 
CORS_ORIGINS=https://localhost:7086,http://localhost:5012  //not enabled yet