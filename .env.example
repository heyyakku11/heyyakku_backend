# Copy this file to .env and fill in real values.
# Never commit .env.

# Database
DB_CONNECTION_STRING=

# Neon Object Storage (S3-compatible). Use the branch storage credential.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Redis (OTP challenge store)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend
# Sender address lives on the published OTP template, not on this request.
RESEND_API_KEY=
RESEND_OTP_TEMPLATE_ID=

# Firebase Cloud Messaging (push notifications)
# Values come from the Firebase service-account JSON (one .env key per JSON field).
# For FIREBASE_PRIVATE_KEY, keep it on one line and use \n for newlines.
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com


# JWT (access tokens). Must be at least 32 characters.
JWT_SECRET=

# CORS Origins. Comma-separated browser SPA origins (not API URLs). Leave empty for same-origin.
CORS_ORIGINS=http://localhost:5173

# Admin registration and password flows
# Secret code an admin must enter (step 2 of registration) to be allowed to register.
ADMIN_SECRET_CODE=
# Web app base URL (no trailing slash) used in email links, e.g. https://admin.example.com
WEB_BASE_URL=
# Resend template ids for the admin emails. Each template receives: heading, email, web_url, expiry_time.
RESEND_ADMIN_REGISTER_TEMPLATE_ID=
RESEND_ADMIN_FORGOT_PASSWORD_TEMPLATE_ID=
RESEND_ADMIN_CHANGE_PASSWORD_TEMPLATE_ID=
