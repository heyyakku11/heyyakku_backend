# Database
DB_CONNECTION_STRING=

# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Web app base URL (no trailing slash) used in email links, e.g. https://admin.example.com
WEB_BASE_URL=
ADMIN_WEB_BASE_URL=

# Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_OTP_TEMPLATE_ID=
# Resend template ids for the admin emails. Each template receives: heading, email, web_url, expiry_time.
RESEND_ADMIN_REGISTER_TEMPLATE_ID=
RESEND_ADMIN_FORGOT_PASSWORD_TEMPLATE_ID=

# Firebase Cloud Messaging (push notifications)
# Values come from the Firebase service-account JSON (one .env key per JSON field).
# For FIREBASE_PRIVATE_KEY, keep it on one line and use \n for newlines.
FIREBASE_TYPE=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=

# JWT (access tokens). Must be at least 32 characters.
JWT_SECRET=

# CORS Origins. Comma separated list of origins.
CORS_ORIGINS=

# Admin registration and password flows
# Secret code an admin must enter (step 2 of registration) to be allowed to register.
ADMIN_SECRET_CODE=

# Admin cookie sessions (see docs/admin-auth.md). Everything below is optional; the defaults are the secure ones.
# Admin origins that may send state-changing requests. ADMIN_WEB_BASE_URL and CORS_ORIGINS are trusted already.
# ADMIN_TRUSTED_ORIGINS=https://admin.example.com
# ADMIN_COOKIE_NAME=__Host-yakku_admin      # default: __Host-yakku_admin (production), yakku_admin (development)
# ADMIN_COOKIE_SAME_SITE=Strict             # Strict | Lax | None (None needs ADMIN_COOKIE_SECURE=true)
# ADMIN_COOKIE_SECURE=true                  # must be true outside development
# ADMIN_CSRF_ENABLED=true                   # cannot be turned off outside development
# ADMIN_SESSION_IDLE_TIMEOUT=00:30:00       # signed out after this long without a request
# ADMIN_SESSION_ABSOLUTE_TIMEOUT=12:00:00   # signed out this long after login however active (max 30 days)
# ADMIN_SESSION_ROTATION_INTERVAL=00:15:00  # the session token is replaced when it is this old
# ADMIN_LOGIN_RATE_LIMIT=10                 # admin auth requests per minute per client
# Number of proxies in front of the API that append to X-Forwarded-For (Render = 1; Vercel proxy + Render = 2).
# TRUSTED_PROXY_HOPS=1
