# Host environment — Development | Staging | Production (selects appsettings.{Environment}.json).
# Use either ASPNETCORE_ENVIRONMENT or ENVIRONMENT (alias). Change this to switch Msg91 and other env-specific settings.
ASPNETCORE_ENVIRONMENT=Development
ENVIRONMENT=Development

# Database
DB_CONNECTION_STRING=

# S3-compatible storage. Generate a credential to fill in the key ID + secret.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Web app base URL (no trailing slash) used in email links, e.g. https://admin.example.com
WEB_BASE_URL=
ADMIN_WEB_BASE_URL=

# Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# MSG91 (OTP SMS via the Flow API). Server-side only: the AuthKey must never reach the app or the web client.
# Do not set MSG91_ENABLED here — enablement comes only from appsettings:
#   appsettings.Development.json → Msg91:Enabled=false
#   appsettings.Staging.json / appsettings.Production.json → Msg91:Enabled=true
# Development (Enabled=false): OTP is still issued, SMS is skipped, and the plaintext OTP is stored in Redis
# under auth:otp:{phone} so you can read and verify it without spending MSG91 credits.
# Staging/Production (Enabled=true): the app refuses to start unless MSG91_AUTH_KEY and MSG91_FLOW_ID are set.
# Flat credential keys below are bridged into Msg91:AuthKey / Msg91:FlowId / Msg91:SenderId.
# The approved flow template must use the single variable ##otp##, with the validity written as fixed text, e.g.
#   Your YAKKU verification code is ##otp##. Use this OTP to verify your mobile number. It is valid for 5 minutes. Do not share it with anyone.
# The OTP validity is a code constant (OtpOptions.ExpiryMinutes), not an environment variable.
# Set ASPNETCORE_ENVIRONMENT=Staging on the staging host so appsettings.Staging.json applies.
# In production set credentials in the Render dashboard (Environment); no .env file is deployed.
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=YAKKU

# Resend — API key only. Template ids are in appsettings.json (Resend:OtpTemplateId, Resend:AdminTemplates).
RESEND_API_KEY=

# Firebase Cloud Messaging (push notifications)
# Values come from the Firebase service-account JSON (one .env key per JSON field).
# For FIREBASE_PRIVATE_KEY, keep it on one line and use \n for newlines.
FIREBASE_TYPE=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=

# Razorpay (one-time Orders/Payments). Server-side only except Key ID, which Checkout needs.
# Do not set RAZORPAY_ENABLED here — enablement comes from appsettings:
#   appsettings.Development.json → Razorpay:Enabled=false
#   appsettings.Staging.json / appsettings.Production.json → Razorpay:Enabled=true
# Development (Enabled=false): the API starts without credentials; payment endpoints will refuse gateway calls.
# Staging/Production (Enabled=true): the app refuses to start unless KEY_ID, KEY_SECRET and WEBHOOK_SECRET are set.
# Use Razorpay Test Mode keys in Development/Staging. Live Mode keys only in Production. Never mix them.
# Only RAZORPAY_KEY_ID is ever returned to clients. KEY_SECRET and WEBHOOK_SECRET must never leave the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional override; default is https://api.razorpay.com/v1
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1
# Non-secret Payment:* defaults (provider, currency, capture mode, order expiry) live in appsettings.json.

# JWT (access tokens). Must be at least 32 characters.
JWT_SECRET=

# CORS Origins. Comma separated list of origins.
CORS_ORIGINS=

# Admin registration and password flows
# Secret code an admin must enter (step 2 of registration) to be allowed to register.
ADMIN_SECRET_CODE=

# Admin cookie sessions (see docs/admin-auth.md). Everything below is optional; the defaults are the secure ones.
# Admin origins that may send state-changing requests. ADMIN_WEB_BASE_URL and CORS_ORIGINS are trusted already.
# ADMIN_TRUSTED_ORIGINS=https://admin.example.com
# ADMIN_COOKIE_NAME=__Host-yakku_admin      # default: __Host-yakku_admin (production), yakku_admin (development)
# ADMIN_COOKIE_SAME_SITE=Strict             # Strict | Lax | None (None needs ADMIN_COOKIE_SECURE=true)
# ADMIN_COOKIE_SECURE=true                  # must be true outside development
# ADMIN_CSRF_ENABLED=true                   # cannot be turned off outside development
# ADMIN_SESSION_IDLE_TIMEOUT=00:30:00       # signed out after this long without a request
# ADMIN_SESSION_ABSOLUTE_TIMEOUT=12:00:00   # signed out this long after login however active (max 30 days)
# ADMIN_SESSION_ROTATION_INTERVAL=00:15:00  # the session token is replaced when it is this old
# ADMIN_LOGIN_RATE_LIMIT=10                 # admin auth requests per minute per client
# Number of proxies in front of the API that append to X-Forwarded-For (Render = 1; Vercel proxy + Render = 2).
# TRUSTED_PROXY_HOPS=1
