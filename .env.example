# Copy this file to .env and fill in real values.
# Never commit .env.

# Database
DB_CONNECTION_STRING=

# Redis (OTP challenge store)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_OTP_TEMPLATE_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT (access tokens). Must be at least 32 characters.
JWT_SECRET=

# Optional. Comma-separated browser origins allowed to send credentials (yakku_guest cookie).
# Leave empty when the API and web app share the same origin.
# CORS_ORIGINS=https://yakku.example.com,http://localhost:3000