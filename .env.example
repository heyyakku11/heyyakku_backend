# Copy this file to .env and fill in real values.
# Never commit .env.

# Database
DB_CONNECTION_STRING=

# Redis (OTP challenge store)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=
RESEND_OTP_TEMPLATE_ID=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# JWT (access tokens). Must be at least 32 characters.
JWT_SECRET=

# CORS Origins. Comma separated list of origins. 
CORS_ORIGINS=https://localhost:7086,http://localhost:5012  //not enabled yet