{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "AccessTokenMinutes": 1,
    "RefreshTokenDays": 1
  },
  "AppVersion": {
    "Android": {
      "MinSupported": "1.0.2",
      "Latest": "1.0.2"
    },
    "Ios": {
      "MinSupported": "1.0.0",
      "Latest": "1.0.0"
    }
  },
  "Msg91": {
    "Enabled": true
  },
  "Razorpay": {
    "Enabled": true
  },
  "Database": {
    "AutoMigrate": true
  },
  "ForwardedHeaders": {
    "ProxyHopCount": 1
  }
}
