{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "VoteNotifications": {
    "ImmediateVoteLimit": 3,
    "FrequencyWindowSeconds": 60,
    "BatchThreshold": 3,
    "IndividualThreshold": 2,
    "LowFrequencyPeriodsToReset": 2,
    "EvaluationPeriodSeconds": 60,
    "MaximumBatchWaitSeconds": 30,
    "QuietPeriods": [
      { "MinVotesPerMinute": 3, "QuietPeriodSeconds": 15 },
      { "MinVotesPerMinute": 6, "QuietPeriodSeconds": 10 },
      { "MinVotesPerMinute": 16, "QuietPeriodSeconds": 5 }
    ],
    "SchedulerPollIntervalMs": 1000,
    "IdleRedisPollSeconds": 10,
    "SchedulerBatchSize": 20,
    "ClassificationBatchSize": 20,
    "RecoverySweepIntervalSeconds": 5,
    "OverdueGraceSeconds": 15,
    "ClassificationLeaseSeconds": 30,
    "SendLeaseSeconds": 120,
    "QueueLeaseSeconds": 30,
    "RedisFallbackAfterSeconds": 120,
    "ClassificationRetrySeconds": 5,
    "OrphanedPendingSeconds": 300,
    "StateTtlSeconds": 86400,
    "MaxAttempts": 4,
    "RetryBackoffSeconds": [ 5, 30, 120 ]
  }
}
